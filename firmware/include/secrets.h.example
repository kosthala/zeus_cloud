// OPTIONAL. Copy to include/secrets.h (git-ignored) only for a USB-flashed build.
// On the first boot these values are copied into the device's flash (NVS) and used from there,
// so the generic OTA release binary (which contains no secrets) keeps working afterwards.
// You can also leave this file out and type everything into the setup portal instead.
#ifndef SECRETS_H
#define SECRETS_H

// Setup access point (password must be >= 8 chars)
#define WM_AP_NAME        "ZeusSetup"
#define WM_AP_PASSWORD    "change-me-please"

// HiveMQ Cloud (use a dedicated credential, ideally with topic ACLs)
#define MQTT_HOST         "your-instance.s1.eu.hivemq.cloud"
#define MQTT_PORT         8883
#define MQTT_USER         "your-mqtt-user"
#define MQTT_PASSWORD     "your-mqtt-password"

// ntfy.sh - the topic name IS the secret on a public server: make it long and random
#define NTFY_TOPIC        "zeus-change-me-to-a-long-random-string"

// Gmail SMTP (use a NEW app password)
#define AUTHOR_EMAIL      "you@gmail.com"
#define AUTHOR_PASSWORD   "your-16-char-app-password"
#define RECIPIENT_EMAIL   "you@gmail.com"

// Only needed if OTA_ARDUINO_ENABLE is 1 in config.h
// #define OTA_LAN_PASSWORD "another-password"

#endif
